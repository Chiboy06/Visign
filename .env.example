# Copy to .env (never commit .env). Server-only: none of these may start with NEXT_PUBLIC_.

# Meta Model API: https://dev.meta.ai/ (dashboard → API keys)
MODEL_API_KEY=

# Supabase: Project settings → API. The service-role key bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Cloud: Project settings → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
