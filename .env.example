# Copy to .env (never commit .env). Server-only: none of these may start with NEXT_PUBLIC_.

# Meta Model API: https://dev.meta.ai/ (dashboard → API keys)
MODEL_API_KEY=

# Supabase: Project Settings → API Keys (or the Connect dialog). Project URL looks like https://<ref>.supabase.co
# Use a SECRET key (sb_secret_...). It bypasses RLS: server only, never NEXT_PUBLIC_.
# Not the legacy service_role JWT (starts with eyJ): Supabase deprecates it by the end of 2026.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# LiveKit Cloud: Settings → API keys. URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
